---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <BaseHead title="Mmmhh je crois que tu t'es trompé de bouton..." description="Saint-Valentin" />
</head>
<body>
    <Header />
    
    <main>
        <div class="no-container">
            <h1>Mmmhh je crois que tu t'es trompée de bouton....</h1>
            <p>Hum Hum on reprend : Veux-tu être ma valentine ?</p>
            
            <div class="buttons">
                <a href="/yes" class="btn btn-yes">Oui</a>
                <a href="/no2-meme" class="btn btn-no">Non</a>
            </div>
        </div>
    </main>
    
    <Footer />

    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
        }

        main {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .no-container {
            text-align: center;
            padding: 2rem;
        }

        h1 {
            font-size: 2.5rem;
            color: #666;
            margin-bottom: 1rem;
        }

        p {
            font-size: 1.5rem;
            color: #888;
            margin-bottom: 3rem;
        }

        .buttons {
            display: flex;
            gap: 2rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            padding: 1.5rem 3rem;
            font-size: 1.5rem;
            border-radius: 50px;
            text-decoration: none;
            font-weight: bold;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

        .btn-yes {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
        }

        .btn-yes:hover {
            transform: scale(1.1);
        }

        .btn-no {
            background: #ddd;
            color: #666;
        }

        @media (max-width: 768px) {
            h1 {
                font-size: 1.8rem;
            }
            
            p {
                font-size: 1.2rem;
            }
            
            .btn {
                padding: 1rem 2rem;
                font-size: 1.2rem;
            }
        }
    </style>
</body>
</html>