---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Mettez le chemin de votre image ici
const valentineImage = "../assets/cat_val4.jpg"; // À CHANGER
---

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <BaseHead title=" Yesss!" description="Saint-Valentin" />
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>
</head>
<body>
    <Header />
    
    <main>
        <div class="yes-container">
            <h1> YESSS ! </h1>
            <img src={"cat_val4.jpg"} alt="Valentine" class="valentine-img" />
            <p>Je reviens vers toi avec une heure et un lieu très prochainement :)</p>
        </div>
    </main>
    
    <Footer />

    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
        }

        main {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .yes-container {
            text-align: center;
            padding: 2rem;
        }

        h1 {
            font-size: 3rem;
            color: #e91e63;
            margin-bottom: 2rem;
            animation: bounce 1s infinite;
        }

        .valentine-img {
            max-width: 500px;
            width: 100%;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(233, 30, 99, 0.3);
        }

        @keyframes bounce {
            0%, 100% {
                transform: translateY(0);
            }
            50% {
                transform: translateY(-20px);
            }
        }

        @media (max-width: 768px) {
            h1 {
                font-size: 2rem;
            }
            
            .valentine-img {
                max-width: 100%;
            }
        }
    </style>

    <script>
        // Lancer les paillettes !
        function launchConfetti() {
            const duration = 5000;
            const end = Date.now() + duration;

            const colors = ['#ff0a54', '#ff477e', '#ff7096', '#ff85a1', '#fbb1bd'];

            (function frame() {
                confetti({
                    particleCount: 5,
                    angle: 60,
                    spread: 55,
                    origin: { x: 0 },
                    colors: colors
                });
                
                confetti({
                    particleCount: 5,
                    angle: 120,
                    spread: 55,
                    origin: { x: 1 },
                    colors: colors
                });

                if (Date.now() < end) {
                    requestAnimationFrame(frame);
                }
            }());
        }

        // Lancer au chargement
        //window.addEventListener('load', launchConfetti);


        async function sendTelegramNotification() {
        const botToken = import.meta.env.PUBLIC_TELEGRAM_BOT_TOKEN;
        const chatId = import.meta.env.PUBLIC_TELEGRAM_CHAT_ID;
        
        const message = `Elle a dit oui, mais prend pas la confiance\n\n` +
            `Maintenant faut organisé hein...\n\n` +
            `Heure : ${new Date().toLocaleString('fr-FR')}`;
        
        try {
            await fetch(`https://api.telegram.org/bot${botToken}/sendMessage`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json; charset=utf-8',
                },
                body: JSON.stringify({
                    chat_id: chatId,
                    text: message,
                }),
            });
        } catch (error) {
            console.error('Erreur notification Telegram:', error);
        }
        }
        
        // Envoyer la notification au chargement de la page
        window.addEventListener('load', () => {
            sendTelegramNotification();
            launchConfetti(); // Garder aussi les paillettes
        });
    </script>

    <script>
    // Envoyer notification Telegram

</script>


</body>
</html>