---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// capacite = volume (en cl) d'un "contenant plein"
const drinks = [
    {
        key: 'biere',
        nom: 'Bière',
        emoji: '🍺',
        color: '#e8960c',
        capacite: 50,
        contenant: 'pinte',
        boutons: [
            { label: 'Demi', cl: 25 },
            { label: 'Pinte', cl: 50 },
        ],
    },
    {
        key: 'vin',
        nom: 'Vin',
        emoji: '🍷',
        color: '#9b1d4a',
        capacite: 75,
        contenant: 'bouteille',
        boutons: [
            { label: 'Verre', cl: 12 },
            { label: 'Grand verre', cl: 18 },
        ],
    },
    {
        key: 'autre',
        nom: 'Autre',
        emoji: '🥃',
        color: '#1f9e8f',
        capacite: 70,
        contenant: 'bouteille',
        boutons: [
            { label: 'Shot', cl: 4 },
            { label: 'Cocktail', cl: 15 },
        ],
    },
];
---

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <BaseHead title="Le compteur 🍻" description="Compteur de boissons" />
</head>
<body>
    <Header />

    <main>
        <div class="counter-page">
            <header class="board-head">
                <div>
                    <h1>Le compteur</h1>
                    <p class="subtitle">Chaque gorgée compte.</p>
                </div>
                <div class="total">
                    <span class="total-value"><span id="total-liters">0.00</span> L</span>
                    <span class="total-label">au total</span>
                </div>
            </header>

            <div class="board">
                {drinks.map((d) => (
                    <section class="drink-row" id={`row-${d.key}`} style={`--c: ${d.color}`}>
                        <div class="row-top">
                            <h2><span class="emoji" aria-hidden="true">{d.emoji}</span> {d.nom}</h2>
                            <span class="row-liters"><span id={`liters-${d.key}`}>0.00</span> L</span>
                        </div>

                        <div class="gauge" role="presentation">
                            <div class="gauge-fill" id={`fill-${d.key}`}></div>
                        </div>

                        <div class="row-meta">
                            <span>
                                <strong class="full-count" id={`full-${d.key}`}>0</strong>
                                <span id={`full-label-${d.key}`} data-contenant={d.contenant}>{d.contenant} pleine</span>
                            </span>
                            <span class="pct-label">
                                <span id={`pct-${d.key}`}>0%</span> de la prochaine ({d.capacite} cl)
                            </span>
                        </div>

                        <div class="buttons">
                            {d.boutons.map((b) => (
                                <button class="add-btn" data-cat={d.key} data-cl={b.cl}>
                                    + {b.label} <small>{b.cl} cl</small>
                                </button>
                            ))}
                            <button class="undo-btn" data-cat={d.key} title="Annuler le dernier" aria-label={`Annuler le dernier (${d.nom})`}>
                                ↩︎ <span class="undo-text">Annuler</span>
                            </button>
                        </div>
                    </section>
                ))}
            </div>

            <div id="status" role="status"></div>
        </div>
    </main>

    <Footer />

    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
        }

        main {
            flex: 1;
            width: 100%;
            max-width: 720px;
            margin: 0 auto;
            padding: 2rem 1rem;
            box-sizing: border-box;
        }

        .board-head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 1.5rem;
        }

        h1 {
            font-size: 2rem;
            margin: 0;
            color: #2d3142;
            line-height: 1.1;
        }

        .subtitle {
            color: #7a8094;
            margin: 0.3rem 0 0;
            font-size: 1rem;
        }

        .total {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
        }

        .total-value {
            font-size: 2.6rem;
            font-weight: 800;
            color: #2d3142;
            line-height: 1;
            font-variant-numeric: tabular-nums;
        }

        .total-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #7a8094;
            margin-top: 0.3rem;
        }

        .board {
            background: white;
            border: 1px solid #e6e9f0;
            border-radius: 18px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
            overflow: hidden;
        }

        .drink-row {
            padding: 1.4rem 1.5rem;
            border-bottom: 1px solid #eef0f5;
        }

        .drink-row:last-child {
            border-bottom: none;
        }

        .row-top {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 0.7rem;
        }

        .row-top h2 {
            margin: 0;
            font-size: 1.15rem;
            color: #2d3142;
        }

        .emoji {
            margin-right: 0.2rem;
        }

        .row-liters {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--c);
            font-variant-numeric: tabular-nums;
        }

        .gauge {
            height: 14px;
            background: #f0f2f6;
            border-radius: 999px;
            overflow: hidden;
        }

        .gauge-fill {
            height: 100%;
            width: 0%;
            background: var(--c);
            border-radius: 999px;
            transition: width 0.6s cubic-bezier(0.34, 1.2, 0.5, 1);
        }

        .gauge-fill.no-transition {
            transition: none;
        }

        .drink-row.full .gauge-fill {
            animation: flash 0.9s ease;
        }

        .row-meta {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            margin-top: 0.5rem;
            font-size: 0.85rem;
            color: #7a8094;
        }

        .full-count {
            display: inline-block;
            color: #2d3142;
            font-size: 1rem;
            font-variant-numeric: tabular-nums;
        }

        .full-count.bump {
            animation: bump 0.5s ease;
            color: var(--c);
        }

        .buttons {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            margin-top: 1rem;
        }

        .add-btn {
            flex: 1 1 8rem;
            background: var(--c);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
            font-weight: 700;
            cursor: pointer;
            font-family: inherit;
            transition: transform 0.15s ease, filter 0.15s ease;
        }

        .add-btn small {
            opacity: 0.8;
            font-weight: 500;
            margin-left: 0.25rem;
        }

        .add-btn:hover {
            filter: brightness(1.08);
        }

        .add-btn:active {
            transform: scale(0.97);
        }

        .undo-btn {
            flex: 0 0 auto;
            background: transparent;
            border: 1px solid #dfe3eb;
            border-radius: 12px;
            color: #7a8094;
            font-size: 0.9rem;
            cursor: pointer;
            font-family: inherit;
            padding: 0.75rem 0.9rem;
            transition: color 0.15s ease, border-color 0.15s ease;
        }

        .undo-btn:hover {
            color: #2d3142;
            border-color: #b9c0cf;
        }

        #status {
            margin-top: 1rem;
            min-height: 1.5rem;
            text-align: center;
            color: #c0392b;
            font-weight: 600;
        }

        @keyframes flash {
            0%, 100% { filter: none; }
            30%, 70% { filter: brightness(1.35) saturate(1.2); }
        }

        @keyframes bump {
            0% { transform: scale(1); }
            40% { transform: scale(1.5); }
            100% { transform: scale(1); }
        }

        @media (max-width: 480px) {
            .drink-row {
                padding: 1.2rem 1rem;
            }

            .total {
                align-items: flex-start;
            }

            .undo-text {
                display: none;
            }

            .add-btn small {
                display: block;
                margin: 0.1rem 0 0;
            }
        }
    </style>

    <script>
        // Configuration (doit rester cohérente avec le frontmatter)
        const CAPACITES = { biere: 50, vin: 75, autre: 70 };
        import { API_URL } from '../scripts/api-url';
        const totals = { biere: 0, vin: 0, autre: 0 };
        const statusDiv = document.getElementById('status');

        // Appel à l'API : renvoie le JSON, ou lève une erreur avec le message du serveur
        async function api(path, options = {}) {
            const res = await fetch(`${API_URL}${path}`, options);
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || 'Erreur réseau');
            return data;
        }

        // Remplace les totaux locaux par ceux du serveur
        function applyTotals(serverTotals) {
            Object.keys(CAPACITES).forEach((cat) => {
                totals[cat] = Number(serverTotals[cat]) || 0;
            });
        }

        function showError(msg) {
            statusDiv.textContent = msg;
            setTimeout(() => (statusDiv.textContent = ''), 4000);
        }

        function bump(el) {
            el.classList.remove('bump');
            void el.offsetWidth;
            el.classList.add('bump');
        }

        // Met à jour les chiffres (litres, nombre de contenants pleins, %)
        function renderStats(cat, animate = false) {
            const cap = CAPACITES[cat];
            const total = totals[cat];
            const fullEl = document.getElementById(`full-${cat}`);
            const newFull = Math.floor(total / cap);

            document.getElementById(`liters-${cat}`).textContent = (total / 100).toFixed(2);
            document.getElementById(`pct-${cat}`).textContent = Math.round(((total % cap) / cap) * 100) + '%';

            if (animate && String(newFull) !== fullEl.textContent) bump(fullEl);
            fullEl.textContent = newFull;
            const labelEl = document.getElementById(`full-label-${cat}`);
            labelEl.textContent = newFull > 1
                ? `${labelEl.dataset.contenant}s pleines`
                : `${labelEl.dataset.contenant} pleine`;

            const all = totals.biere + totals.vin + totals.autre;
            document.getElementById('total-liters').textContent = (all / 100).toFixed(2);
        }

        // Remplissage de la jauge (0 à 1)
        function setLevel(cat, fraction) {
            document.getElementById(`fill-${cat}`).style.width = `${fraction * 100}%`;
        }

        // Ajoute du volume avec animation (jauge pleine -> flash, on vide et on repart avec le reste)
        async function animateAdd(cat, before, after) {
            const cap = CAPACITES[cat];
            const row = document.getElementById(`row-${cat}`);
            const fill = document.getElementById(`fill-${cat}`);

            row.classList.remove('full');

            if (Math.floor(after / cap) > Math.floor(before / cap)) {
                setLevel(cat, 1);
                await new Promise((r) => setTimeout(r, 600));
                void row.offsetWidth;
                row.classList.add('full');
                await new Promise((r) => setTimeout(r, 900));
                fill.classList.add('no-transition');
                setLevel(cat, 0);
                void fill.offsetWidth;
                fill.classList.remove('no-transition');
                await new Promise((r) => setTimeout(r, 50));
            }
            setLevel(cat, (after % cap) / cap);
        }

        // Réaffiche chiffres et niveaux des trois jauges
        function renderAll() {
            Object.keys(CAPACITES).forEach((cat) => {
                renderStats(cat);
                setLevel(cat, (totals[cat] % CAPACITES[cat]) / CAPACITES[cat]);
            });
        }

        // Charger les données au démarrage
        async function init() {
            try {
                applyTotals(await api('/boissons'));
            } catch (e) {
                showError('Impossible de charger le compteur.');
            }

            Object.keys(CAPACITES).forEach((cat) => {
                renderStats(cat);
                // petit délai pour que l'animation de remplissage se voie au chargement
                setTimeout(() => setLevel(cat, (totals[cat] % CAPACITES[cat]) / CAPACITES[cat]), 200);
            });
        }

        // Boutons "+"
        document.querySelectorAll('.add-btn').forEach((btn) => {
            btn.addEventListener('click', async () => {
                const cat = btn.dataset.cat;
                const cl = Number(btn.dataset.cl);

                // Mise à jour immédiate de l'affichage, puis enregistrement côté serveur
                const before = totals[cat];
                totals[cat] += cl;
                renderStats(cat, true);
                const animation = animateAdd(cat, before, totals[cat]);

                try {
                    applyTotals(await api('/boissons', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ categorie: cat, volume_cl: cl }),
                    }));
                } catch (e) {
                    totals[cat] = Math.max(0, totals[cat] - cl);
                    showError("Impossible d'enregistrer, réessaie.");
                }

                await animation;
                renderAll();
            });
        });

        // Boutons "Annuler le dernier"
        document.querySelectorAll('.undo-btn').forEach((btn) => {
            btn.addEventListener('click', async () => {
                const cat = btn.dataset.cat;

                try {
                    applyTotals(await api(`/boissons/dernier?categorie=${encodeURIComponent(cat)}`, {
                        method: 'DELETE',
                    }));
                } catch (e) {
                    showError(e.message === 'Rien à annuler.' ? e.message : "Impossible d'annuler, réessaie.");
                    return;
                }

                renderAll();
            });
        });

        init();
    </script>
</body>
</html>
