---
// Fenêtre de recadrage d'une photo, pilotée par createCropper (src/scripts/cropper.ts).
// Une seule par page : les ids crop-* sont fixes.
interface Props {
	title: string;
	// Largeur / hauteur du cadre : 2 pour les couvertures d'articles, 2/3 pour les livres
	aspect: number;
}

const { title, aspect } = Astro.props;
---

<div class="crop-modal" id="crop-modal" hidden role="dialog" aria-modal="true" aria-labelledby="crop-title" style={`--aspect: ${aspect}`}>
	<div class="crop-dialog">
		<h2 id="crop-title">{title}</h2>
		<div class="crop-stage" id="crop-stage"></div>
		<div class="crop-zoom">
			<span aria-hidden="true">🔍</span>
			<input type="range" id="crop-zoom" min="1" max="4" step="0.01" value="1" aria-label="Zoom" />
		</div>
		<div class="crop-actions">
			<button type="button" id="crop-cancel">Annuler</button>
			<button type="button" class="confirm" id="crop-confirm">Valider</button>
		</div>
	</div>
</div>

<style>
	.crop-modal {
		position: fixed;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 2000;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
		background: rgba(15, 15, 20, 0.75);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
	}
	.crop-modal[hidden] {
		display: none;
	}
	.crop-dialog {
		width: min(820px, 100%);
		padding: 1.5rem;
		background: white;
		border-radius: 20px;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
	}
	.crop-dialog h2 {
		margin: 0 0 1rem;
		font-size: 1.2rem;
		color: #333;
		text-align: center;
	}
	/* Le cadre garde son format et ne dépasse pas ~60 % de la hauteur d'écran (utile en portrait) */
	.crop-stage {
		position: relative;
		width: min(100%, calc(60vh * var(--aspect)));
		margin: 0 auto;
		aspect-ratio: var(--aspect);
		overflow: hidden;
		border-radius: 12px;
		background: #111;
		cursor: grab;
		touch-action: none;
		user-select: none;
	}
	.crop-stage:active {
		cursor: grabbing;
	}
	.crop-stage :global(.crop-source) {
		position: absolute;
		top: 0;
		left: 0;
		transform-origin: 0 0;
		pointer-events: none;
	}
	.crop-zoom {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		margin: 1.2rem 0;
		color: #999;
	}
	.crop-zoom input {
		flex: 1;
		accent-color: #667eea;
	}
	.crop-actions {
		display: flex;
		justify-content: flex-end;
		gap: 0.8rem;
	}
	.crop-actions button {
		padding: 0.6rem 1.3rem;
		border: 2px solid #e0e0e0;
		border-radius: 50px;
		background: white;
		color: #555;
		font: inherit;
		font-size: 0.9rem;
		cursor: pointer;
		transition: all 0.2s ease;
	}
	.crop-actions button:hover {
		border-color: #667eea;
		background: #f5f7ff;
		color: #667eea;
	}
	.crop-actions .confirm {
		border-color: #667eea;
		background: #667eea;
		color: white;
		font-weight: 600;
	}
	.crop-actions .confirm:hover {
		background: #5a6fd6;
		color: white;
	}
	@media (max-width: 720px) {
		.crop-dialog {
			padding: 1rem;
		}
	}
</style>
