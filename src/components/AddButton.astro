---
// Bouton d'ajout épuré avec une pastille léopard (« Nouveau post », « Ajouter un livre »…)
interface Props {
	href: string;
	label: string;
}

const { href, label } = Astro.props;
---

<a class="add-button" href={href}><span class="badge" aria-hidden="true">+</span>{label}</a>

<style>
	.add-button {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.4rem 1.2rem 0.4rem 0.4rem;
		background: white;
		border: 1px solid #e6e6e6;
		border-radius: 50px;
		color: #333;
		font-weight: 600;
		text-decoration: none;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}
	.add-button:hover {
		transform: translateY(-1px);
		border-color: #d6d6d6;
		box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
	}
	/* La touche léopard : une pastille ronde avec le + */
	.badge {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background-image: url('/Leopard.jpg');
		background-size: 220%;
		background-position: center;
		box-shadow: inset 0 0 0 40px rgba(0, 0, 0, 0.28);
		color: white;
		font-size: 1.3rem;
		font-weight: 700;
		line-height: 1;
		text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
	}
</style>
