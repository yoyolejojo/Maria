{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maria-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maria-db",
      // Ne pas changer cet id : la base locale de test est rangée sous ce nom
      "database_id": "58cd728f-c615-4c00-8c9f-0df5fb48c20a",
      "migrations_dir": "migrations"
    },
    {
      // Photos des articles, séparées pour garder maria-db légère (500 Mo max par base)
      "binding": "PHOTOS",
      "database_name": "maria-photos",
      "database_id": "70256c22-5d70-4cda-a707-7dd20499877d",
      "migrations_dir": "migrations-photos"
    }
  ],

  // Anti-spam des notifications Telegram ("va dormir", page yes)
  "ratelimits": [
    {
      "name": "NOTIFY_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],

  // En local, .dev.vars remplace ces valeurs
  "vars": {
    "ALLOWED_ORIGINS": "https://mariaetyoyo.netlify.app",
    // "true" seulement dans .dev.vars : autorise les adresses du réseau local (test sur téléphone)
    "DEV_ALLOW_LAN": "false"
  },

  "secrets": {
    "required": ["TELEGRAM_BOT_TOKEN", "TELEGRAM_CHAT_ID"]
  }
}
